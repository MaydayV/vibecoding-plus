#
# Copy this file to .env and fill in your own credentials.
# Relative paths are resolved from the repository root.
#
STT_PROVIDER=qwen_asr
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_API_KEY=
QWEN_ASR_LANGUAGE=zh
QWEN_ASR_PROMPT=
QWEN_ASR_TIMEOUT_MS=45000
QWEN_ASR_SAMPLE_RATE=16000
QWEN_ASR_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANGUAGE=zh
WHISPER_CPP_COMMAND=whisper-cli
WHISPER_CPP_MODEL_PATH=
WHISPER_CPP_LANGUAGE=zh
WHISPER_CPP_THREADS=4
WHISPER_CPP_EXTRA_ARGS=
WHISPER_CPP_TIMEOUT_MS=45000
VOLCENGINE_APP_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCENGINE_LANGUAGE=zh-CN
LAN_VOICE_BIND=0.0.0.0
LAN_VOICE_PORT=8765
LAN_DISCOVERY_ENABLED=1
LAN_DISCOVERY_PORT=8766
LAN_DISCOVERY_HOST_ID=
LAN_SHARED_SECRET=
LAN_AUTH_WINDOW_SEC=300
LAN_TRUST_LOCALHOST=0
LAN_AUDIO_MAX_BYTES=2097152
LAN_AUDIO_MAX_MS=120000
SEND_TARGET=codex_exec
TRANSCRIPT_DELIVERY_MODE=confirm_on_device
TEXT_INJECTION_MODE=type_and_enter
TODO_INTENT_PROVIDER=rules
TODO_INTENT_API_KEY=
TODO_INTENT_MODEL=deepseek-chat
TODO_INTENT_BASE_URL=https://api.deepseek.com
TODO_INTENT_TIMEOUT_MS=8000
TODO_FOLLOWUP_TIMEOUT_MS=30000
CODEX_COMMAND=codex
CODEX_CWD=.
CODEX_SKIP_GIT_REPO_CHECK=0
CLAUDE_COMMAND=claude
CLAUDE_CWD=.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Bash,Glob,Grep
CLAUDE_MAX_TURNS=10
CLI_TIMEOUT_SEC=300
TERMINAL_MIRROR_ENABLED=0
TERMINAL_MIRROR_TARGETS=
TERMINAL_MIRROR_SESSION=vibehost
TERMINAL_MIRROR_WINDOW=node
TERMINAL_MIRROR_INTERVAL_MS=800
TERMINAL_MIRROR_LINES=60
DRY_RUN_TEXT_INJECTION=1
MOCK_TRANSCRIPT=
SAVE_DEBUG_WAV=0
